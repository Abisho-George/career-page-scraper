# Google Sheet ID: the long string between /d/ and /edit in the sheet URL
SHEET_ID=
# Contact address placed in the User-Agent so site owners can reach you
CONTACT_EMAIL=you@example.com
# Path to the service-account key (never commit it)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# 0 = no cap. Companies least recently checked go first.
MAX_COMPANIES_PER_RUN=0

# Optional tuning (defaults shown)
# DB_PATH=data/jobs.db
# MIN_DELAY=2
# MAX_DELAY=5
# REQUEST_TIMEOUT=20
# MAX_PARALLEL_COMPANIES=5
# MAX_BROWSER_PAGES=2
# COMPANY_TIMEOUT=900
# HEURISTIC_MAX_LINKS=150
# MAX_DETAIL_FETCHES=200
# USE_BROWSER=1
# BROWSER_EXECUTABLE=
# JOBS_TAB_CLOSED_DAYS=7
